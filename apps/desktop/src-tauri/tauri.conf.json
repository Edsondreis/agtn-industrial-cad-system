{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGTN Industrial CAD",
  "version": "1.1.0",
  "identifier": "br.com.agtn.cad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AGTN Industrial CAD",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "backgroundColor": "#0f1114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "AGTN",
    "copyright": "© AGTN. Todos os direitos reservados.",
    "category": "DeveloperTool",
    "shortDescription": "AGTN Industrial CAD",
    "longDescription": "Software CAD 2D da AGTN para desenho técnico, chapas e planificação, com compatibilidade DXF e DWG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "agtncad"
        ],
        "name": "Projeto AGTN Industrial CAD",
        "description": "Projeto AGTN Industrial CAD",
        "role": "Editor"
      },
      {
        "ext": [
          "dxf"
        ],
        "name": "AGTNCAD.DXF",
        "description": "Desenho DXF",
        "role": "Editor"
      },
      {
        "ext": [
          "dwg"
        ],
        "name": "AGTNCAD.DWG",
        "description": "Desenho DWG (AutoCAD)",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
